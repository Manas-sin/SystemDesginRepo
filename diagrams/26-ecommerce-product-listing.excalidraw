   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "① Estimate, then pick\n100 items × 1 KB = 100 KB:\nfits any single node.\nStructured rows (title, price,\ncolour) → a relational DB.\nNever fancier than the data\nneeds.",
   "originalText": "① Estimate, then pick\n100 items × 1 KB = 100 KB:\nfits any single node.\nStructured rows (title, price,\ncolour) → a relational DB.\nNever fancier than the data\nneeds.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

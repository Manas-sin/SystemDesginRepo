   "roundness": null,
   "seed": 899680760,
   "version": 1,
   "versionNonce": 1148025345,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "⑥ Replica vs cache\nBoth scale reads. Replica: no\ninvalidation, slower, costs a\nDB server. Cache: faster and\ncheaper per read, but you must\ndelete keys on every write.",
   "originalText": "⑥ Replica vs cache\nBoth scale reads. Replica: no\ninvalidation, slower, costs a\nDB server. Cache: faster and\ncheaper per read, but you must\ndelete keys on every write.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }

   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "each API server opens 2 connections: main + replica,\nand picks one at random for every read",
   "originalText": "each API server opens 2 connections: main + replica,\nand picks one at random for every read",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e35fa3635",
   "type": "text",
   "x": 520,
   "y": 492,
   "width": 421.85,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#0b7285",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 84196940,
   "version": 1,
   "versionNonce": 2065920251,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "no cache → nothing to invalidate:\nan admin write lands on main and is copied to every replica",
   "originalText": "no cache → nothing to invalidate:\nan admin write lands on main and is copied to every replica",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e558818e9",
   "type": "text",
   "x": 0,
   "y": 500,
   "width": 493.35,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 166688708,
   "version": 1,
   "versionNonce": 1641903440,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "LOAD PER BOX:  frontend huge → scale out  ·  backend high → scale out\nadmin UI: one user → 1 server (+ spare)  ·  DB: read-heavy → replicas",
   "originalText": "LOAD PER BOX:  frontend huge → scale out  ·  backend high → scale out\nadmin UI: one user → 1 server (+ spare)  ·  DB: read-heavy → replicas",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e476f06be",
   "type": "text",
   "x": 1080,
   "y": 78,
   "width": 280.5,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1230563834,
   "version": 1,
   "versionNonce": 1694566832,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "B · Scale reads: replica or cache?",
   "originalText": "B · Scale reads: replica or cache?",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e700fa82c",

  {
   "id": "e13743aab",
   "type": "text",
   "x": 520,
   "y": 445,
   "width": 371.8,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",

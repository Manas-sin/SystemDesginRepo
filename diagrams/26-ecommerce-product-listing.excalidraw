   "seed": 1265133104,
   "version": 1,
   "versionNonce": 391578344,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "⑤ Read-heavy → replicas\nCustomers only read. Add\nreplicas; each API server\nopens two connections and\npicks one per read. Main\nserves reads too — that is not\na rule.",
   "originalText": "⑤ Read-heavy → replicas\nCustomers only read. Add\nreplicas; each API server\nopens two connections and\npicks one per read. Main\nserves reads too — that is not\na rule.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

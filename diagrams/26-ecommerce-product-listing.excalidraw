   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "cache"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1757400422,
   "version": 1,
   "versionNonce": 673767655,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false
  },
  {
   "id": "e2b892122",
   "type": "text",
   "x": 1094,
   "y": 137.5,
   "width": 257.40000000000003,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "cache"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1493135432,
   "version": 1,
   "versionNonce": 752002366,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "Cache (Redis) — not chosen\n+ µs reads, takes load off the DB\n− every admin write must delete\n   the stale key; can serve old data",
   "originalText": "Cache (Redis) — not chosen\n+ µs reads, takes load off the DB\n− every admin write must delete\n   the stale key; can serve old data",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e4c144fe7",
   "type": "rectangle",
   "x": 1080,
   "y": 260,
   "width": 260,
   "height": 120,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "rep"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1066600998,
   "version": 1,
   "versionNonce": 1245315470,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false
  },
  {
   "id": "e66008e6f",
   "type": "text",
   "x": 1094,
   "y": 287.5,
   "width": 278.85,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "rep"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 979693494,
   "version": 1,
   "versionNonce": 147667305,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "Read replicas — chosen\n+ nothing to invalidate: replication\n   carries every write to every copy\n− each replica is a DB server; ms reads",
   "originalText": "Read replicas — chosen\n+ nothing to invalidate: replication\n   carries every write to every copy\n− each replica is a DB server; ms reads",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e6b841080",
   "type": "text",
   "x": 1080,
   "y": 400,
   "width": 278.85,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 200995868,
   "version": 1,
   "versionNonce": 2028687212,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "Both are valid. Picked replicas because\nwrites are rare and tiny (one owner,\n100 items). Just because a cache\nexists does not mean you add it.",
   "originalText": "Both are valid. Picked replicas because\nwrites are rare and tiny (one owner,\n100 items). Just because a cache\nexists does not mean you add it.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e228d5ec1",
   "type": "text",
   "x": 1080,
   "y": 480,
   "width": 271.70000000000005,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1018118421,
   "version": 1,
   "versionNonce": 1496886435,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "Watch out: replication is async, so an\nowner may read an old row for a moment\n→ send the admin’s reads to main.",
   "originalText": "Watch out: replication is async, so an\nowner may read an old row for a moment\n→ send the admin’s reads to main.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "③ Three tiers\nBrowser → compute → storage.\nThe browser is the Customers\nbox; the frontend box is\nservers that send it pages.\nOnly the DB holds state, so\nonly the DB needs copies.",
   "originalText": "③ Three tiers\nBrowser → compute → storage.\nThe browser is the Customers\nbox; the frontend box is\nservers that send it pages.\nOnly the DB holds state, so\nonly the DB needs copies.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

  {
   "id": "e5a6b351e",
   "type": "text",
   "x": 235,
   "y": 579,
   "width": 214.50000000000003,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",

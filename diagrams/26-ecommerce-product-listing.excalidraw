   "seed": 498123580,
   "version": 1,
   "versionNonce": 1414153797,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "④ Separate admin UI\nSame backend, different\nfrontend. Admin code stays out\nof the public bundle and bugs\nstay apart. Backend checks the\nrole on every write.",
   "originalText": "④ Separate admin UI\nSame backend, different\nfrontend. Admin code stays out\nof the public bundle and bugs\nstay apart. Backend checks the\nrole on every write.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

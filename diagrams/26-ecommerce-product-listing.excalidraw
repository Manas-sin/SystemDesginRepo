   "versionNonce": 2118421926,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792336271693,
   "link": null,
   "locked": false,
   "text": "② A box = LB + servers\nAny box with N stateless\nservers has a load balancer in\nfront and autoscaling behind.\nDrawing it as one box keeps\nthe picture clean.",
   "originalText": "② A box = LB + servers\nAny box with N stateless\nservers has a load balancer in\nfront and autoscaling behind.\nDrawing it as one box keeps\nthe picture clean.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

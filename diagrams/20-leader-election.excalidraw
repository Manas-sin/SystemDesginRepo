   "boundElements": [],
   "updated": 1791906203453,
   "link": null,
   "locked": false,
   "text": "② Leader watches workers\nDead worker → start a new\nworker. Leader and workers run\nthe same code; leader is just\na role.",
   "originalText": "② Leader watches workers\nDead worker → start a new\nworker. Leader and workers run\nthe same code; leader is just\na role.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true

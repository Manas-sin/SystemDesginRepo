   "updated": 1791906203453,
   "link": null,
   "locked": false,
   "text": "③ Heartbeat + timeout\nLeader says 'alive' every ~1\ns. Silence past the timeout =\npresumed dead. Too short:\nfalse alarms. Too long: slow\nrecovery.",
   "originalText": "③ Heartbeat + timeout\nLeader says 'alive' every ~1\ns. Silence past the timeout =\npresumed dead. Too short:\nfalse alarms. Too long: slow\nrecovery.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

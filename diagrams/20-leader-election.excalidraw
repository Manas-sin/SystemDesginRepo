   "updated": 1791906203453,
   "link": null,
   "locked": false,
   "text": "⑤ Split brain\nA network split can create two\nleaders. Rule: leader only\nwith a majority (3 of 5). Use\nodd group sizes.",
   "originalText": "⑤ Split brain\nA network split can create two\nleaders. Rule: leader only\nwith a majority (3 of 5). Use\nodd group sizes.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",

   "boundElements": [],
   "updated": 1791906203453,
   "link": null,
   "locked": false,
   "text": "② Reuse the connection\nHTTP/1.1 keeps it open (keep-\nalive). HTTP/2 lets many\nrequests share one connection\nat the same time.",
   "originalText": "② Reuse the connection\nHTTP/1.1 keeps it open (keep-\nalive). HTTP/2 lets many\nrequests share one connection\nat the same time.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,

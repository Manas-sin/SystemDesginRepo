   "updated": 1791906203453,
   "link": null,
   "locked": false,
   "text": "① TCP first\nEvery connection starts with a\n3-message handshake: one round\ntrip (TLS adds 1–2). Opening\nconnections is the expensive\npart.",
   "originalText": "① TCP first\nEvery connection starts with a\n3-message handshake: one round\ntrip (TLS adds 1–2). Opening\nconnections is the expensive\npart.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

  },
  {
   "id": "e2a327662",
   "type": "text",
   "x": 460,
   "y": 519,
   "width": 214.50000000000003,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",

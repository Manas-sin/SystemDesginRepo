  {
   "id": "e216c3905",
   "type": "text",
   "x": 10,
   "y": 519,
   "width": 214.50000000000003,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,

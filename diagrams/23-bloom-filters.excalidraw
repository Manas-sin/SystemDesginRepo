   "version": 1,
   "versionNonce": 478978338,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "③ The bit array\nm bits, all zero at start. ~10\nbits per item ≈ 1% false\npositives. 100M items ≈ 120 MB\n— fits in RAM.",
   "originalText": "③ The bit array\nm bits, all zero at start. ~10\nbits per item ≈ 1% false\npositives. 100M items ≈ 120 MB\n— fits in RAM.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

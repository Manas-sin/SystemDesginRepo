  },
  {
   "id": "e62cedc8c",
   "type": "text",
   "x": 235,
   "y": 519,
   "width": 207.35000000000002,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "note2"

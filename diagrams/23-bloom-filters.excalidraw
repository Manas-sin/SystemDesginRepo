   "frameId": null,
   "roundness": null,
   "seed": 1058240950,
   "version": 1,
   "versionNonce": 763564744,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "⑥ The trade\nYou give up: exactness,\ndelete, listing, resizing. You\nget: tiny memory, O(k) time,\nand never a false “no”.",
   "originalText": "⑥ The trade\nYou give up: exactness,\ndelete, listing, resizing. You\nget: tiny memory, O(k) time,\nand never a false “no”.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }

   "frameId": null,
   "roundness": null,
   "seed": 1113248781,
   "version": 1,
   "versionNonce": 787481804,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "① Add an item\nRun it through k hash\nfunctions (here 3). Each gives\na position in the bit array.\nSet those k bits to 1. The\nitem itself is NOT stored.",
   "originalText": "① Add an item\nRun it through k hash\nfunctions (here 3). Each gives\na position in the bit array.\nSet those k bits to 1. The\nitem itself is NOT stored.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e7441d0eb",

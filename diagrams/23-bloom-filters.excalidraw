   "seed": 1628484994,
   "version": 1,
   "versionNonce": 1831006406,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "④ Check an item\nHash it the same way. Any bit\nstill 0 → definitely absent.\nAll k bits 1 → probably\npresent (a collision is\npossible).",
   "originalText": "④ Check an item\nHash it the same way. Any bit\nstill 0 → definitely absent.\nAll k bits 1 → probably\npresent (a collision is\npossible).",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

   "frameId": null,
   "roundness": null,
   "seed": 478443796,
   "version": 1,
   "versionNonce": 1143733459,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "② Hash functions\nFast, non-cryptographic:\nMurmurHash, xxHash. Trick:\ncompute two hashes h1, h2 and\nget k of them as h1 + i·h2.",
   "originalText": "② Hash functions\nFast, non-cryptographic:\nMurmurHash, xxHash. Trick:\ncompute two hashes h1, h2 and\nget k of them as h1 + i·h2.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {

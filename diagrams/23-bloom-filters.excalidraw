   "roundness": null,
   "seed": 860463132,
   "version": 1,
   "versionNonce": 1588865204,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792316706386,
   "link": null,
   "locked": false,
   "text": "⑤ Put it in front\nA cheap memory check before\nthe expensive disk / network /\nDB lookup. Every true “no” is\nanswered without the lookup.",
   "originalText": "⑤ Put it in front\nA cheap memory check before\nthe expensive disk / network /\nDB lookup. Every true “no” is\nanswered without the lookup.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },

   "link": null,
   "locked": false,
   "text": "③ Standby replica\nLive copy, seconds behind.\nMain dies → promote it\n(failover, about a minute).\nCosts a second server.",
   "originalText": "③ Standby replica\nLive copy, seconds behind.\nMain dies → promote it\n(failover, about a minute).\nCosts a second server.",
